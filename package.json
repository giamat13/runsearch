{
  "name": "runsearch",
  "version": "1.0.0",
  "description": "A PowerToys Run style launcher for Windows, built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:settings": "node scripts/build-settings.js <path-to-PowerToys>/src/modules/launcher/Plugins/Microsoft.PowerToys.Run.Plugin.WindowsSettings data/windows-settings.json"
  },
  "keywords": ["launcher", "powertoys-run", "electron", "windows", "productivity"],
