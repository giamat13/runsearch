  "repository": {
    "type": "git",
    "url": "git+https://github.com/giamat13/runsearch.git"
  },
  "bugs": {
    "url": "https://github.com/giamat13/runsearch/issues"
  },
  "homepage": "https://github.com/giamat13/runsearch#readme",
  "devDependencies": {
    "electron": "^45.0.0"
  }
}
